// Money Gestion - Schema V1 (FCFA, Neon Postgres)
// Comptes: Especes + Epargne extensible | Budgets + Epargne multi-objectifs + Dettes

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth v5) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wallets       Wallet[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  debts         Debt[]

  @@map("mg_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("mg_auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mg_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("mg_verification_tokens")
}

// ---------- Metier ----------
enum WalletType {
  ESPECES
  EPARGNE
  WAVE
  ORANGE_MONEY
  BANQUE
  AUTRE
}

enum TransactionType {
  REVENU
  DEPENSE
  TRANSFERT
}

enum CategoryType {
  REVENU
  DEPENSE
  MIXTE
}

enum DebtStatus {
  EN_COURS
  SOLDE
}

model Wallet {
  id             String     @id @default(cuid())
  userId         String
  name           String
  type           WalletType @default(ESPECES)
  initialBalance Int        @default(0) // en FCFA
  color          String     @default("#10b981")
  icon           String     @default("wallet")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("FromWallet")
  received     Transaction[] @relation("ToWallet")
  savingsGoals SavingsGoal[]

  @@index([userId])
  @@map("mg_wallets")
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType @default(DEPENSE)
  color     String       @default("#6366f1")
  icon      String       @default("tag")
  createdAt DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("mg_categories")
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String
  walletId   String
  toWalletId String?
  categoryId String?
  type       TransactionType
  amount     Int // FCFA, toujours positif
  date       DateTime        @default(now())
  note       String?
  importHash String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet    @relation("FromWallet", fields: [walletId], references: [id], onDelete: Cascade)
  toWallet Wallet?   @relation("ToWallet", fields: [toWalletId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([walletId])
  @@index([categoryId])
  @@map("mg_transactions")
}

model Budget {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String
  year            Int
  month           Int // 1-12
  limit           Int // plafond FCFA
  alertThreshold  Int      @default(80) // %
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, year, month])
  @@index([userId, year, month])
  @@map("mg_budgets")
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  walletId      String?
  name          String
  targetAmount  Int // objectif FCFA
  currentAmount Int       @default(0)
  deadline      DateTime?
  color         String    @default("#f59e0b")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("mg_savings_goals")
}

model Debt {
  id              String     @id @default(cuid())
  userId          String
  creditor        String
  description     String?
  initialAmount   Int
  remainingAmount Int
  monthlyPayment  Int?
  dueDate         DateTime?
  status          DebtStatus @default(EN_COURS)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("mg_debts")
}
